<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DriveRent | @(ViewData["Title"] ?? "Car Rental")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
    @if (ViewData["PageCss"] is string pageCss && !string.IsNullOrWhiteSpace(pageCss))
    {
        <link rel="stylesheet" href="~/css/@pageCss" asp-append-version="true" />
    }
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var navbarClass = "navbar navbar-expand-lg main-navbar";
        if (ViewData["NavbarExtraClass"] is string extraClass && !string.IsNullOrWhiteSpace(extraClass))
        {
            navbarClass += " " + extraClass;
        }

        bool IsActive(string controller, string? action = null)
        {
            if (!string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }

            if (string.IsNullOrEmpty(action))
            {
                return true;
            }

            return string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
        }
    }

    <nav class="@navbarClass">
        <div class="container">
            <a class="navbar-brand logo" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-car-side"></i>
                <span>Drive<span>Rent</span></span>
            </a>
            <button class="navbar-toggler menu-button"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-label="Toggle navigation">
                <i class="fa-solid fa-bars"></i>
            </button>
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Home", "Index") ? "active" : null)" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Car") ? "active" : null)" asp-controller="Car" asp-action="Index">Cars</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Home", "About") ? "active" : null)" asp-controller="Home" asp-action="About">About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Home", "Contact") ? "active" : null)" asp-controller="Home" asp-action="Contact">Contact</a>
                    </li>
                </ul>
                <div class="navbar-buttons">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Super"))
                        {
                            <a asp-controller="Admin" asp-action="Index" class="login-link">Dashboard</a>
                        }
                        <a asp-controller="Reservation" asp-action="MyReservations" class="login-link @(IsActive("Reservation", "MyReservations") ? "active-account" : null)">My Reservations</a>
                        <a asp-controller="Account" asp-action="Logout" class="btn primary-button">Log Out</a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="login-link">Login</a>
                        <a asp-controller="Account" asp-action="Register" class="btn primary-button">Sign Up</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    @RenderBody()

    <partial name="_SiteFooter" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/main.js" asp-append-version="true"></script>
    @if (ViewData["PageJs"] is string pageJs && !string.IsNullOrWhiteSpace(pageJs))
    {
        <script src="~/js/@pageJs" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
