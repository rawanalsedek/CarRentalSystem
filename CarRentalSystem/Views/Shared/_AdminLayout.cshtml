<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DriveRent Admin | @(ViewData["Title"] ?? "Dashboard")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    @{
        var section = ViewData["AdminSection"]?.ToString();
    }
    <div class="admin-shell">
        <aside class="admin-sidebar" id="adminSidebar">
            <a class="admin-logo" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-car-side"></i>
                <span>Drive<span>Rent</span></span>
            </a>
            <span class="admin-label">ADMIN PANEL</span>
            <nav class="admin-nav">
                <a class="@(section == "dashboard" ? "active" : null)" asp-controller="Admin" asp-action="Index">
                    <i class="fa-solid fa-table-columns"></i>
                    Dashboard
                </a>
                <a class="@(section == "cars" ? "active" : null)" asp-controller="Car" asp-action="Manage">
                    <i class="fa-solid fa-car"></i>
                    Cars
                </a>
                <a class="@(section == "categories" ? "active" : null)" asp-controller="Category" asp-action="Index">
                    <i class="fa-solid fa-layer-group"></i>
                    Categories
                </a>
                <a class="@(section == "reservations" ? "active" : null)" asp-controller="Reservation" asp-action="Index">
                    <i class="fa-solid fa-calendar-days"></i>
                    Reservations
                </a>
                <a class="@(section == "customers" ? "active" : null)" asp-controller="Admin" asp-action="Customers">
                    <i class="fa-solid fa-users"></i>
                    Customers
                </a>
            </nav>
            <div class="admin-bottom">
                <a class="admin-logout" asp-controller="Account" asp-action="Logout">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    Logout
                </a>
            </div>
        </aside>
        <main class="admin-main">
            <div class="admin-mobile-bar">
                <button class="admin-menu" id="adminMenu" type="button">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <a class="admin-logo" asp-controller="Admin" asp-action="Index">
                    <i class="fa-solid fa-car-side"></i>
                    <span>Drive<span>Rent</span></span>
                </a>
            </div>
            @RenderBody()
        </main>
    </div>
    @RenderSection("Modals", required: false)
    <partial name="_SiteFooter" />
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
